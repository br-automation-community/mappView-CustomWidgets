		<Children></Children>
		<Methods>
			<Method name="Focus" read="false">
				<Description>Sets focus on the widget element, if it can be focused and keyboardOperation=true</Description>
			</Method>
			<Method name="ShowTooltip" read="false"/>
		</Methods>
		<Events>
			<Event name="DisabledClick">
				<Description>Fired when disabled element is clicked on.</Description>
				<Arguments>
					<Argument name="origin" type="String" index="0" required="true">
						<Description>id of widget that triggered this event</Description>
					</Argument>
					<Argument name="hasPermission" type="Boolean" index="1" required="true">
						<Description>defines if the state is caused due to missing roles of the current user</Description>
					</Argument>
					<Argument name="horizontalPos" type="String" index="2" required="true">
						<Description>horizontal position of click in pixel i.e &apos;10px&apos;</Description>
					</Argument>
					<Argument name="verticalPos" type="String" index="3" required="true">
						<Description>vertical position of click in pixel i.e &apos;10px&apos;</Description>
					</Argument>
				</Arguments>
			</Event>
			<Event name="FocusIn">
				<Description>Fired when the widgets gets focus</Description>
			</Event>
			<Event name="FocusOut">
				<Description>Fired when the widgets lost focus</Description>
			</Event>
		</Events>
		<Properties>
			<Property name="autoRaise" type="brease.enum.AutoRaise" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" defaultValue="enabled">
				<Description>Can be used to configure the behavior of raising a window above others when the user
clicks on it. The default behavior will raise the window automaically when the user clicks on it				</Description>
			</Property>
			<Property name="enable" type="Boolean" initOnly="false" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Behavior" defaultValue="true">
				<Description>Initial option to enable widget.</Description>
			</Property>
			<Property name="modal" type="Boolean" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" defaultValue="true">
				<Description>If true, the window will be modal, in the meaning that no interaction with beneath page is possible. A semi transparent overlay between window and parent application will catch user actions.
It depends on settings &apos;showCloseButton&apos; and &apos;forceInteraction&apos; how the user can close the window.				</Description>
			</Property>
			<Property name="permissionOperate" type="RoleCollection" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Accessibility">
				<Description>restricts operability to users, which have given roles</Description>
			</Property>
			<Property name="permissionView" type="RoleCollection" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Accessibility">
				<Description>restricts visibility to users, which have given roles</Description>
			</Property>
			<Property name="position" type="Object" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" defaultValue="{&apos;horizontal&apos;:&apos;center&apos;, &apos;vertical&apos;:&apos;middle&apos;}">
				<Description>Horizontal and vertical position of the Window.
Example: {&apos;horizontal&apos;: &apos;center&apos;, &apos;vertical&apos;: 105}				</Description>
			</Property>
			<Property name="style" type="StyleReference" initOnly="false" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Appearance" defaultValue="default">
				<Description>reference to a style for this widget type</Description>
			</Property>
			<Property name="tabIndex" type="Integer" initOnly="true" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Behavior" defaultValue="-1">
				<Description>sets if a widget should have autofocus enabled (0), the order of the focus (&gt;0),
or if autofocus should be disabled (-1)				</Description>
			</Property>
			<Property name="tooltip" type="String" initOnly="true" localizable="true" editableBinding="false" readOnly="false" required="false" projectable="true" category="Appearance" defaultValue="">
				<Description>reference to a tooltip for a widget</Description>
			</Property>
			<Property name="visible" type="Boolean" initOnly="false" localizable="false" editableBinding="false" readOnly="false" required="false" projectable="true" category="Behavior" defaultValue="true">
				<Description>change visibility</Description>
			</Property>
		</Properties>
		<StyleProperties>
			<StyleProperty name="width" type="Size" not_styleable="true" owner="widgets.brXtended.TimePicker" category="Layout" groupRefId="Size" groupOrder="1" default="296">
				<StyleElement attribute="@include mixins.elemWidth($value)"/>
				<Description>outer width of widget</Description>
			</StyleProperty>
			<StyleProperty name="height" type="Size" not_styleable="true" owner="widgets.brXtended.TimePicker" category="Layout" groupRefId="Size" groupOrder="2" default="360">
				<StyleElement attribute="@include mixins.elemHeight($value)"/>
				<Description>outer height of widget</Description>
			</StyleProperty>
			<StyleProperty name="top" type="Integer" not_styleable="true" owner="brease.core.BaseWidget" category="Layout" groupRefId="Position" groupOrder="1">
				<StyleElement attribute="@include mixins.elemTop($value)"/>
				<Description>absolute position measured from top boundary of parent container</Description>
			</StyleProperty>
			<StyleProperty name="left" type="Integer" not_styleable="true" owner="brease.core.BaseWidget" category="Layout" groupRefId="Position" groupOrder="2">
				<StyleElement attribute="@include mixins.elemLeft($value)"/>
				<Description>absolute position measured from left boundary of parent container</Description>
			</StyleProperty>
			<StyleProperty name="zIndex" type="UInteger" not_styleable="true" owner="brease.core.BaseWidget" category="Layout" required="true">
				<StyleElement attribute="z-index"/>
				<Description>The zIndex property specifies the z-order of a widget and its childs.&lt;br/&gt;
        When widgets overlap, z-order determines which one covers the other. A widget with a larger zIndex generally covers a widget with a lower one.&lt;br/&gt;
        The zIndex must be unique within a content.&lt;br/&gt;				</Description>
			</StyleProperty>
			<StyleProperty name="cornerRadius" category="Appearance" type="PixelValCollection" default="0px" owner="widgets.brXtended.TimePicker">
				<StyleElement attribute="@include mixins.border-radius($value)"/>
				<StyleElement selector="header" attribute="@include mixins.border-top-radius($value)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl" attribute="@include mixins.border-bottom-radius($value-9px)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter" attribute="@include mixins.border-bottom-right-radius($value-9px)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset" attribute="@include mixins.border-bottom-left-radius($value-9px)"/>
				<Description>corner radius of the edge of TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="headerGradient" category="Appearance" type="Gradient" default="" owner="widgets.brXtended.TimePicker">
				<StyleElement selector="header" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<Description>color gradient of header</Description>
			</StyleProperty>
			<StyleProperty name="borderColor" category="Appearance" type="ColorCollection" default="#333333" owner="widgets.brXtended.TimePicker">
				<StyleElement attribute="border-color"/>
				<StyleElement selector="header" attribute="background-color"/>
				<StyleElement selector="&amp;.arrowLeft .breaseWindowArrow" attribute="border-right-color"/>
				<StyleElement selector="&amp;.arrowRight .breaseWindowArrow" attribute="border-left-color"/>
				<StyleElement selector="&amp;.arrowTop .breaseWindowArrow" attribute="border-bottom-color"/>
				<StyleElement selector="&amp;.arrowBottom .breaseWindowArrow" attribute="border-top-color"/>
				<Description>border color of TimePicker including header and arrow</Description>
			</StyleProperty>
			<StyleProperty name="textColor" category="Appearance" type="Color" default="#000000" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody button" attribute="color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="color"/>
				<Description>text color for whole TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="valueTextColor" category="Appearance" type="Color" default="#000000" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="color"/>
				<Description>text color of value display</Description>
			</StyleProperty>
			<StyleProperty name="opacity" category="Appearance" type="Opacity" default="1" owner="widgets.brXtended.TimePicker">
				<StyleElement attribute="opacity"/>
				<Description>opacity of whole TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="fontName" category="Appearance" type="FontName" default="Arial" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="font-family"/>
				<StyleElement selector=".dateTimePickerBody button" attribute="font-family"/>
				<Description>font name for whole TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="shadow" category="Appearance" type="Shadow" default="none" owner="widgets.brXtended.TimePicker">
				<StyleElement attribute="@include mixins.box-shadow($value)"/>
				<Description>shadow of whole TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="backColor" category="Appearance" type="Color" default="#FFFFFF" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody button" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons button" attribute="border-bottom-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter.active" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset.active" attribute="background-color"/>
				<Description>background color of TimePicker except the header</Description>
			</StyleProperty>
			<StyleProperty name="valueBackColor" category="Appearance" type="Color" default="#FFFFFF" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="background-color"/>
				<Description>back color of value display</Description>
			</StyleProperty>
			<StyleProperty name="headerBackColor" category="Appearance" type="Color" default="#000000" owner="widgets.brXtended.TimePicker">
				<StyleElement selector="header" attribute="background-color"/>
				<Description>text color for header of TimePicker</Description>
			</StyleProperty>
			<StyleProperty name="backGroundGradient" category="Appearance" type="Gradient" default="" owner="widgets.brXtended.TimePicker">
				<StyleElement attribute="@include mixins.backGroundGradient($value)"/>
				<StyleElement selector=".dateTimePickerBody" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody button" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .space" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons .dtfragment" attribute="@include mixins.borderImageGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons button" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<Description>background gradient of TimePicker except the header</Description>
			</StyleProperty>
			<StyleProperty name="valueBackGroundGradient" category="Appearance" type="Gradient" default="" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerHeadings .actDate" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<Description>color gradient of value display</Description>
			</StyleProperty>
			<StyleProperty name="buttonEnterResetBorderWidth" category="Appearance" type="PixelValCollection" default="1px" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter" attribute="border-left-width"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset" attribute="border-right-width"/>
				<Description>color gradient of value display</Description>
			</StyleProperty>
			<StyleProperty name="buttonEnterResetBorderStyle" category="Appearance" type="BorderStyle" default="solid" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter" attribute="border-left-style"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset" attribute="border-right-style"/>
				<Description>color gradient of value display</Description>
			</StyleProperty>
			<StyleProperty name="buttonEnterResetBorderColor" category="Appearance" type="Color" default="#333" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter" attribute="border-left-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset" attribute="border-right-color"/>
				<Description>color gradient of value display</Description>
			</StyleProperty>
			<StyleProperty name="mouseDownBackColor" category="Appearance" type="Color" default="#FF8800" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter.active" attribute="background-color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset.active" attribute="background-color"/>
				<Description>background color of enter and reset button in pressed state</Description>
			</StyleProperty>
			<StyleProperty name="mouseDownTextColor" category="Appearance" type="Color" default="#FFFFFF" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter.active" attribute="color"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset.active" attribute="color"/>
				<Description>text color of enter and reset button in pressed state</Description>
			</StyleProperty>
			<StyleProperty name="buttonBackGroundGradient" category="Appearance" type="Gradient" default="" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter:not(.active)" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset:not(.active)" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<Description>background gradient of enter and reset button</Description>
			</StyleProperty>
			<StyleProperty name="buttonMouseDownBackGroundGradient" category="Appearance" type="Gradient" default="" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerEnter.active" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<StyleElement selector=".dateTimePickerBody .dateTimePickerControl .dateTimePickerReset.active" attribute="@include mixins.backGroundGradient(&apos;$value&apos;)"/>
				<Description>background gradient of enter and reset button in mousedown state</Description>
			</StyleProperty>
			<StyleProperty name="lineColor" category="Appearance" type="Color" default="#d4d4d4" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons button" attribute="border-bottom-color"/>
				<Description>color of separating lines between wheel values</Description>
			</StyleProperty>
			<StyleProperty name="activeLineColor" category="Appearance" type="Color" default="#FF8800" owner="widgets.brXtended.TimePicker">
				<StyleElement selector=".dateTimePickerBody .dateTimePickerButtons .marker" attribute="background-color"/>
				<Description>color of separating lines above and below selected wheel values</Description>
			</StyleProperty>
